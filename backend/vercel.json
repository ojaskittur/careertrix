{
    "functions": {
        "api/index.py": {
            "runtime": "python3.9",
            "memory": 512,
            "maxDuration": 10,
            "excludeFiles": [
                "**/__pycache__/**",
                "**/*.pyc",
                "**/*.pyo",
                "db.sqlite3",
                ".env",
                ".git/**",
                "node_modules/**",
                "backend/migrations/**"
            ]
        }
    },
    "builds": [
        {
            "src": "backend/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "50mb",
                "runtime": "python3.9",
                "excludeFiles": [
                    "**/__pycache__/**",
                    "**/*.pyc",
                    "**/*.pyo",
                    "db.sqlite3",
                    ".env",
                    ".git/**",
                    "node_modules/**",
                    "backend/migrations/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "backend/wsgi.py"
        }
    ]
}
